<?xml version="1.0" encoding="utf-8"?>
<CatapultSkin
  Version="6"
  SkinType="WebHelp2"
  Comment="HTML5 Default Tripane skin"
  Anchors="Width,Height"
  Width="800"
  Height="600"
  Top="0"
  Left="0"
  Bottom="0"
  Right="0"
  Tabs="TOC,Index,Community"
  DefaultTab="TOC"
  UseBrowserDefaultSize="True"
  UseDefaultBrowserSetup="True"
  EnableResponsiveOutput="True"
  AutoSyncTOC="true">
  <Stylesheet>
    <Styles>
      <Style
        Name="Search Micro Content Response Button">
        <Properties>
          <Property
            Name="BackgroundRepeat">no-repeat</Property>
        </Properties>
      </Style>
      <Style
        Name="Main Page">
        <Properties>
          <Property
            Name="BackgroundColor">#bc8f8f</Property>
          <Property
            Name="BackgroundImage">none</Property>
        </Properties>
      </Style>
      <Style
        Name="Navigation Panel">
        <Properties>
          <Property
            Name="BackgroundColor">#a9a9a9</Property>
        </Properties>
      </Style>
      <Style
        Name="Navigation Tab (active)">
        <Properties>
          <Property
            Name="BackgroundColor">#32cd32</Property>
          <Property
            Name="BackgroundImage">none</Property>
        </Properties>
      </Style>
      <Style
        Name="Navigation Tab (inactive)">
        <Properties>
          <Property
            Name="BackgroundColor">#8b0000</Property>
          <Property
            Name="BackgroundImage">none</Property>
        </Properties>
      </Style>
    </Styles>
  </Stylesheet>
  <Strings />
  <WebHelpOptions />
</CatapultSkin>